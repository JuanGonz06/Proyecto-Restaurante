# Copia este archivo como .env y ajusta los valores. NO subas .env a GitHub.

# desarrollo | produccion  (fuera de desarrollo SECRET_KEY es obligatoria y no se devuelve el token de recuperación)
ENTORNO=desarrollo

# SQLite local por defecto. Para Neon (PostgreSQL) pega tu cadena de conexión:
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./restaurante.db

# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=clave-solo-para-desarrollo-cambiar-en-produccion-123

# Orígenes permitidos (el front Angular en desarrollo corre en :4200). Separa varios con coma.
CORS_ORIGINS=http://localhost:4200

# Carga menú, usuarios y pedidos de ejemplo si la base está vacía (contraseña de todas las cuentas: 123456)
CARGAR_DATOS_EJEMPLO=true
